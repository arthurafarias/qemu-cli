#!/usr/bin/env python3
"""Thin entry point: adds ../lib to sys.path and hands off to qemu_cli.cli.

All actual behavior lives in the qemu_cli package (lib/qemu_cli/), which
is also installable/importable on its own via pyproject.toml.
"""

import os
import sys

_LIB_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)

from qemu_cli.cli import main

if __name__ == "__main__":
    main()
